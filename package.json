{
  "name": "ct-deal-finder",
  "version": "1.0.0",
  "description": "Private Node.js script to find below-market CT real estate deals via Judicial foreclosures and bank REO listings",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "scrape:judicial": "node scrapers/judicial.js",
    "scrape:banks": "node scrapers/bankReo.js",
    "scrape:all": "node scrapers/judicial.js && node scrapers/bankReo.js"
  },
  "keywords": [
    "real-estate",
    "foreclosure",
    "investment",
    "scraper",
    "ct"
